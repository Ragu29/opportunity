# Copy to .env.dev (local / demo) or .env (prod server, NODE_ENV=prod). Never commit the real files.

PORT=3040
# base path the gateway forwards: https://<host>/onesify/opportunity/...
BASE_PATH=/onesify/opportunity/api/v1

# HTTPS: point to the shared server certificate (/home/sslportal/onesify/cert/...). Leave empty to serve plain HTTP (local dev).
SSL_KEY_PATH=
SSL_CERT_PATH=

# MongoDB (this service keeps its own collections: opportunities, opportunity_documents)
MONGODB_CLUSTER=mongodb://host:27017
MONGODB_DBNAME=onesify_opportunity
DB_USERNAME=
DB_PASSWORD=

# Oracle Sales Cloud (only this service holds these)
OPPORTUNITY_BASE_URL=https://cbjl-test.fa.us2.oraclecloud.com
OPPORTUNITY_ATTACHMENT_URL=https://cbjl-test.fa.us2.oraclecloud.com/salesApi/resources/11.12.1.0/opportunities
OPPORTUNITY_USERNAME=
OPPORTUNITY_PASSWORD=
OPPORTUNITY_RETRY_ATTEMPTS=4
OPPORTUNITY_RETRY_DELAY_MS=5000

# Service-to-service auth: one key per product, "PRODUCTCODE:key" comma separated.
# A caller can only act on the product its key belongs to (x-api-key header).
SERVICE_API_KEYS=CCD:change-me-ccd,CCC:change-me-ccc

# Hosts the service may download a signed document from (attachment.url on /order-placed), comma separated
ALLOWED_DOCUMENT_HOSTS=onesifydemo.sifytechnologies.com

# Per product: callback URL (events: opportunity.created, salesOrder.created, flow.completed, failed, dropped)
# and mail recipients for the status mails (comma separated)
CALLBACK_URL_CCD=https://localhost:4027/onesify/crossconnect_domestic/opportunity/callback
MAIL_RECIPIENTS_CCD=
CALLBACK_URL_CCC=
MAIL_RECIPIENTS_CCC=
# token sent as "Authorization: Bearer <token>" on callbacks, so the product can verify them
CALLBACK_TOKEN=change-me-callback

# SMTP (same server the products use)
SMTP_Mail_Host=
SMTP_Mail_port=587
SMTP_TO_EMAIL=
SMTP_TO_PASSWORD=
